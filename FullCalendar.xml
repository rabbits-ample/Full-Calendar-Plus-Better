<?xml version="1.0" encoding="utf-8"?>
<widget id="rapiddata technologies.fullcalendar.FullCalendar" pluginWidget="true" needsEntityContext="false" offlineCapable="true"
        supportedPlatform="Web"
        xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>FullCalendarPlus</name>
    <description>Display events in a FullCalendar-based interactive calendar with multiple views, locale support, RTL, and drag/resize capabilities.</description>
    <icon>
        
    </icon>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Calendar Events">
                <property key="eventsDataSource" type="datasource" isList="true" required="true">
                    <caption>Events datasource</caption>
                    <description>Calendar events datasource</description>
                </property>
                <property key="titleAttribute" type="attribute" required="false" dataSource="eventsDataSource">
                    <caption>Event Title</caption>
                    <description>Attribute of the events datasource entity: event title (String)</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                    </attributeTypes>
                </property>
                <property key="allDayAttribute" type="attribute" required="false" dataSource="eventsDataSource">
                    <caption>All day</caption>
                    <description>Attribute of the events datasource entity: Boolean for all-day event</description>
                    <attributeTypes>
                        <attributeType name="Boolean"/>
                    </attributeTypes>
                </property>
                <property key="startDateAttribute" type="attribute" required="true" dataSource="eventsDataSource">
                    <caption>Event Start Date</caption>
                    <description>Attribute of the events datasource entity: event start datetime</description>
                    <attributeTypes>
                        <attributeType name="DateTime"/>
                    </attributeTypes>
                </property>
                <property key="endDateAttribute" type="attribute" required="true" dataSource="eventsDataSource">
                    <caption>Event End Date</caption>
                    <description>Attribute of the events datasource entity: event end datetime</description>
                    <attributeTypes>
                        <attributeType name="DateTime"/>
                    </attributeTypes>
                </property>
                <property key="colorAttribute" type="attribute" required="false" dataSource="eventsDataSource">
                    <caption>Color</caption>
                    <description>Attribute of the events datasource entity: event color (e.g. "red", "#FFF000", "rgb(250,10,20)")</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                    </attributeTypes>
                </property>
                <property key="textColorAttribute" type="attribute" required="false" dataSource="eventsDataSource">
                    <caption>Text Color</caption>
                    <description>Attribute of the events datasource entity: event color (e.g. "red", "#FFF000", "rgb(250,10,20)")</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                    </attributeTypes>
                </property>
                <property key="eventDisplayStyle" type="enumeration" defaultValue="block">
                    <caption>Event display style</caption>
                    <description>Controls which preset rendering style events use. Only Simple and Block are supported.</description>
                    <enumerationValues>
                        <enumerationValue key="auto">Simple</enumerationValue>
                        <enumerationValue key="block">Block</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Calendar View">
                <property key="language" type="expression" required="true">
                    <caption>Language</caption>
                    <description>Language expression for FullCalendar locale(e.g. 'en', 'ta', 'fr', 'ar')
                    </description>
                    <returnType type="String" />
                </property>
                <property key="toolbarMode" type="enumeration" defaultValue="standard">
                    <caption>Toolbar</caption>
                    <description>Default: shows Previous, Next, Today, Title, Month, Week, Day, Year, List. Custom: add only the buttons you need.</description>
                    <enumerationValues>
                        <enumerationValue key="standard">Default</enumerationValue>
                        <enumerationValue key="custom">Custom</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="customToolbar" type="object" isList="true" required="false">
                    <caption>Custom toolbar</caption>
                    <description>When Toolbar is Custom, add items here (e.g. Previous, Next, Today, Title, Month, Week, Day, Year, List).</description>
                    <properties>
                        <property key="button" type="enumeration" defaultValue="dayGridMonth">
                            <caption>Button</caption>
                            <category>Toolbar item</category>
                            <description>Type of toolbar button</description>
                            <enumerationValues>
                                <enumerationValue key="prev">Previous</enumerationValue>
                                <enumerationValue key="next">Next</enumerationValue>
                                <enumerationValue key="today">Today</enumerationValue>
                                <enumerationValue key="title">Title</enumerationValue>
                                <enumerationValue key="dayGridYear">Year</enumerationValue>
                                <enumerationValue key="dayGridMonth">Month</enumerationValue>
                                <enumerationValue key="timeGridWeek">Week</enumerationValue>
                                <enumerationValue key="timeGridDay">Day</enumerationValue>
                                <enumerationValue key="listMonth">List</enumerationValue>
                            </enumerationValues>
                        </property>
                        <property key="position" type="enumeration" defaultValue="right">
                            <caption>Position</caption>
                            <category>Toolbar item</category>
                            <description>Position in toolbar</description>
                            <enumerationValues>
                                <enumerationValue key="left">Left</enumerationValue>
                                <enumerationValue key="center">Center</enumerationValue>
                                <enumerationValue key="right">Right</enumerationValue>
                            </enumerationValues>
                        </property>
                        <property key="caption" type="string" required="false">
                            <caption>Caption</caption>
                            <category>Toolbar item</category>
                            <description>The text for the button</description>
                        </property>
                        <property key="setAsInitialView" type="boolean" defaultValue="false">
                            <caption>Set as initial view?</caption>
                            <category>Toolbar item</category>
                            <description>Use this view when the calendar first loads (only for view buttons: Month, Week, Day, Year, List)</description>
                        </property>
                    </properties>
                </property>
                <property key="initialView" type="enumeration" defaultValue="dayGridMonth">
                    <caption>Select the initial view</caption>
                    <description>The first view to be displayed when the calendar loads.</description>
                    <enumerationValues>
                        <enumerationValue key="timeGridDay">Day</enumerationValue>
                        <enumerationValue key="timeGridWeek">Week</enumerationValue>
                        <enumerationValue key="dayGridMonth">Month</enumerationValue>
                        <enumerationValue key="dayGridYear">Year</enumerationValue>
                        <enumerationValue key="listMonth">List</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="weekStartDay" type="expression" required="false">
                    <caption>Week starts on (1–7)</caption>
                    <description>Expression that resolves to an Integer (1–7).
                    1=Sunday, 2=Monday, 3=Tuesday, 4=Wednesday,
                    5=Thursday, 6=Friday, 7=Saturday.
                    Empty or invalid = Monday.
                    </description>
                    <returnType type="Integer" />
                </property>

            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Events">
            <propertyGroup caption="Selection">
                <property key="selectedEvent" type="selection" required="true" dataSource="eventsDataSource">
                    <caption>Selected event</caption>
                    <description>Holds the clicked event object. In 'On Select Event' → Show a page → Page settings, set the page argument (e.g. Calendar) to 'Selection of [this widget]' to pass the clicked event to the edit page.</description>
                    <selectionTypes>
                        <selectionType name="Single"/>
                    </selectionTypes>
                </property>
            </propertyGroup>
            <propertyGroup caption="Actions">
                <property key="onEventClick" type="action" required="false">
                    <caption>On Select Event</caption>
                    <description>Microflow or Show a page when an event is clicked. Use the 'Selected event' selection above as the page argument for the object.</description>
                </property>
                <property key="onDateSelect" type="action" required="false">
                    <caption>On Date Selected</caption>
                    <description>Microflow to execute when date(s) are selected. A helper entity with start and end dates will be passed to the microflow.</description>
                </property>
                <property key="selectStartAttr" type="attribute" required="false">
                    <caption>Selected start attribute</caption>
                    <description>Populated with the selected range's start before the microflow runs.</description>
                    <attributeTypes>
                        <attributeType name="DateTime"/>
                    </attributeTypes>
                </property>
                <property key="selectEndAttr" type="attribute" required="false">
                    <caption>Selected end attribute</caption>
                    <description>Populated with the selected range's end before the microflow runs.</description>
                    <attributeTypes>
                        <attributeType name="DateTime"/>
                    </attributeTypes>
                </property>
                <property key="onEventDrop" type="action">
                    <caption>On drop an event</caption>
                    <description>Microflow to call when event is dropped</description>
                </property>
                <property key="dropStartAttr" type="attribute" required="true">
                    <caption>Event Start Updated</caption>
                    <description>Populated with the dropped event's start date</description>
                    <attributeTypes>
                        <attributeType name="DateTime"/>
                    </attributeTypes>
                </property>
                <property key="dropEndAttr" type="attribute" required="true" >
                    <caption>Event Start Updated</caption>
                    <description>Populated with the dropped event's end date</description>
                    <attributeTypes>
                        <attributeType name="DateTime"/>
                    </attributeTypes>
                </property>
            </propertyGroup>
            <propertyGroup caption="Event Options">
                <property key="allowDateSelection" type="attribute">
                    <caption>Allow Date selection</caption>
                    <description>Allow user to select date(s) on the calendar</description>
                    <attributeTypes>
                        <attributeType name="Boolean"/>
                    </attributeTypes>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Dimensions">
            <property key="widthMode" type="enumeration" defaultValue="auto">
                <caption>Width</caption>
                <description>Auto or custom</description>
                <enumerationValues>
                    <enumerationValue key="auto">Auto</enumerationValue>
                    <enumerationValue key="custom">Custom</enumerationValue>
                </enumerationValues>
            </property>
            <property key="customWidth" type="string" required="false">
                <caption>Custom Width</caption>
                <description>CSS width (e.g., 100%, 800px)</description>
            </property>
            <property key="heightMode" type="enumeration" defaultValue="auto">
                <caption>Height</caption>
                <description>Auto, fixed, aspect ratio, or content height</description>
                <enumerationValues>
                    <enumerationValue key="auto">Auto</enumerationValue>
                    <enumerationValue key="fixed">Fixed (px)</enumerationValue>
                    <enumerationValue key="aspect">Aspect Ratio</enumerationValue>
                    <enumerationValue key="content">Content Height</enumerationValue>
                </enumerationValues>
            </property>
            <property key="customHeight" type="string" required="false">
                <caption>Custom Height</caption>
                <description>CSS value (e.g., 600px, 80vh)</description>
            </property>
            <property key="aspectRatio" type="string" required="false" defaultValue="16/9">
                <caption>Aspect Ratio</caption>
                <description>Width/height ratio (e.g., 16/9)</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Common">
            <systemProperty key="Name"/>
            <systemProperty key="TabIndex"/>
            <systemProperty key="Visibility"/>
        </propertyGroup>
    </properties>
</widget>
